program records-country-0-65535 seeds
dir mode http deny
dir mode http/server:a deny
dir policy http/server:a log if country == undetermined
dir policy http/server:a log if country in { NL BE EU XK }
dir policy http/server:a log if country != NL
run http/server:a
case country
conf floor 3 0
conf ctx 3 0
tenant fresh 1800000000000 1800000000001
addr floor 198.51.100.7
addr server 198.51.100.7
flags 0 0
rec floor routing asn=64496 country=528 rov=1 rir=5 flags=0 asn_rep=1
sweep floor routing country 0 65535
end
